# No-cost historical end-of-day archive is the default.
# Optional paid provider credentials are kept server-side only.
MARKET_DATA_PROVIDER=community-eod
MDP_API_BASE_URL=
MDP_API_KEY=
MDP_API_SECRET=
MDP_ACCESS_ID=
MDP_API_VERSION=1.0
MARKET_DATA_MODE=unconfigured

# PostgreSQL connection (server only)
DATABASE_URL=

# Public canonical website origin (for sitemap/robots metadata)
SITE_URL=
